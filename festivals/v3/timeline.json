 "shots": [
  {
   "id": 1,
   "section": "open",
   "start": 0.0,
   "dur": 6.99,
   "vo_at": 1.5,
   "vo_dur": 4.89,
   "text": "एउटा दियो बल्छ — र सयौँ वर्ष पुरानो कथा फेरि ब्युँझिन्छ।",
   "f0": 0,
   "f1": 210
  },
  {
   "id": 2,
   "section": "title",
   "start": 6.99,
   "dur": 3.2,
   "vo_at": null,
   "vo_dur": null,
   "text": "दशैँ",
   "f0": 210,
   "f1": 306
  },
  {
   "id": 3,
   "section": "myth",
   "start": 10.19,
   "dur": 9.35,
   "vo_at": 11.49,
   "vo_dur": 7.45,
   "text": "यो कथा देवी माहात्म्यमा छ — मार्कण्डेय पुराणभित्रको, करिब पन्ध्र सय वर्ष पुरानो संस्कृत ग्रन्थ।",
   "f0": 306,
   "f1": 586
  },
  {
   "id": 4,
   "section": "myth",
   "start": 19.54,
   "dur": 7.73,
   "vo_at": 19.94,
   "vo_dur": 6.73,
   "text": "महिषासुरले वरदान पाएको थियो — कुनै देवता वा पुरुषले उसलाई मार्न सक्ने छैनन्।",
   "f0": 586,
   "f1": 818
  },
  {
   "id": 5,
   "section": "myth",
   "start": 27.27,
   "dur": 7.17,
   "vo_at": 27.67,
   "vo_dur": 6.17,
   "text": "त्यसैले सबै देवताको तेज एकै ठाउँ मिल्यो, र जन्मिइन् — शक्ति, दुर्गा।",
   "f0": 818,
   "f1": 1033
  },
  {
   "id": 6,
   "section": "myth",
   "start": 34.44,
   "dur": 8.61,
   "vo_at": 34.84,
   "vo_dur": 7.61,
   "text": "परम्पराअनुसार नौ रात युद्ध चल्यो। दशौँ दिन असत्यमाथि सत्यको जित भयो — विजया दशमी।",
   "f0": 1033,
   "f1": 1292
  },
  {
   "id": 7,
   "section": "myth",
   "start": 43.05,
   "dur": 5.09,
   "vo_at": 43.45,
   "vo_dur": 4.09,
   "text": "रामले रावणमाथि पाएको विजय पनि यही दिनसँग जोडिन्छ।",
   "f0": 1292,
   "f1": 1444
  },
  {
   "id": 8,
   "section": "Nepal",
   "start": 48.14,
   "dur": 5.59,
   "vo_at": 49.44,
   "vo_dur": 3.69,
   "text": "नेपालमा यो चाडको इतिहास दरबारसँग गाँसिएको छ।",
   "f0": 1444,
   "f1": 1612
  },
  {
   "id": 9,
   "section": "Nepal",
   "start": 53.73,
   "dur": 8.69,
   "vo_at": 54.13,
   "vo_dur": 7.69,
   "text": "मल्ल राजाहरूकी कुलदेवी तलेजु भवानी — जसको मन्दिर वर्षमा एक पटक, नवमीमा, आम मानिसका लागि खुल्छ।",
   "f0": 1612,
   "f1": 1873
  },
  {
   "id": 10,
   "section": "Nepal",
   "start": 62.42,
   "dur": 10.53,
   "vo_at": 62.82,
   "vo_dur": 9.53,
   "text": "वि.सं. १८२५ मा उपत्यका जितेपछि पृथ्वीनारायण शाहले गोरखाबाट फूलपाती हनुमानढोका ल्याउने चलन बसालेको मानिन्छ।",
   "f0": 1873,
   "f1": 2188
  },
  {
   "id": 11,
   "section": "days",
   "start": 72.95,
   "dur": 3.99,
   "vo_at": 74.25,
   "vo_dur": 2.09,
   "text": "पहिलो दिन, घटस्थापना।",
   "f0": 2188,
   "f1": 2308
  },
  {
   "id": 12,
   "section": "days",
   "start": 76.94,
   "dur": 6.29,
   "vo_at": 77.34,
   "vo_dur": 5.29,
   "text": "अँध्यारो कोठामा छरिएको जौ घाम नदेखी पहेँलो जमरा बनेर उम्रन्छ।",
   "f0": 2308,
   "f1": 2497
  },
  {
   "id": 13,
   "section": "days",
   "start": 83.23,
   "dur": 10.77,
   "vo_at": 83.63,
   "vo_dur": 9.77,
   "text": "सातौँ दिन फूलपाती — केरा, बेल, बेसार, अनार, धानसहित नौ थरी बिरुवा, र टुँडिखेलमा सलामी।",
   "f0": 2497,
   "f1": 2820
  },
  {
   "id": 14,
   "section": "days",
   "start": 94.0,
   "dur": 7.33,
   "vo_at": 94.4,
   "vo_dur": 6.33,
   "text": "अष्टमीमा कालरात्रिको पूजा; नवमीमा हतियार, औजार र सवारीसाधनको।",
   "f0": 2820,
   "f1": 3040
  },
  {
   "id": 15,
   "section": "days",
   "start": 101.33,
   "dur": 5.89,
   "vo_at": 101.73,
   "vo_dur": 4.89,
   "text": "दशमीमा साइत हेरेर ठूलाबडाको हातबाट रातो टीका र जमरा।",
   "f0": 3040,
   "f1": 3217
  },
  {
   "id": 16,
   "section": "days",
   "start": 107.22,
   "dur": 7.73,
   "vo_at": 107.62,
   "vo_dur": 6.73,
   "text": "अनि पूर्णिमासम्म — कोजाग्रत, 'को जाग्दैछ?' भन्दै लक्ष्मी आउने विश्वास।",
   "f0": 3217,
   "f1": 3448
  },
  {
   "id": 17,
   "section": "people",
   "start": 114.95,
   "dur": 7.51,
   "vo_at": 116.25,
   "vo_dur": 5.61,
   "text": "दशैँ आकाशमा पनि देखिन्छ — गाउँगाउँमा लिङ्गे पिङ, छतछतमा चङ्गा।",
   "f0": 3448,
   "f1": 3674
  },
  {
   "id": 18,
   "section": "people",
   "start": 122.46,
   "dur": 3.57,
   "vo_at": 122.86,
   "vo_dur": 2.57,
   "text": "अनि बाटोभरि घर फर्किनेहरूको लाम।",
   "f0": 3674,
   "f1": 3781
  },
  {
   "id": 19,
   "section": "people",
   "start": 126.03,
   "dur": 8.05,
   "vo_at": 126.43,
   "vo_dur": 7.05,
   "text": "सबै समुदायले यसलाई एउटै तरिकाले मनाउँदैनन्; तर भेटघाट, आशीर्वाद र मिलन धेरैको साझा हो।",
   "f0": 3781,
   "f1": 4022
  },
  {
   "id": 20,
   "section": "blessing",
   "start": 134.08,
   "dur": 6.87,
   "vo_at": 135.38,
   "vo_dur": 4.97,
   "text": "आयु द्रोणसुते, श्रियो दशरथे, शत्रुक्षयं राघवे…",
   "f0": 4022,
   "f1": 4229
  },
  {
   "id": 21,
   "section": "wish",
   "start": 140.95,
   "dur": 6.71,
   "vo_at": 142.25,
   "vo_dur": 4.81,
   "text": "विजया दशमी २०८३ को हार्दिक मंगलमय शुभकामना।",
   "f0": 4229,
   "f1": 4430
  },
  {
   "id": 22,
   "section": "sign",
