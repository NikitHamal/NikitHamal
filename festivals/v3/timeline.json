 "frames": 4792,
 "shots": [
  {
   "id": 1,
   "section": "open",
   "start": 0.0,
   "dur": 8.35,
   "vo_at": 1.5,
   "vo_dur": 6.25,
   "text": "एउटा दियो बल्छ — र सयौँ वर्ष पुरानो कथा फेरि ब्युँझिन्छ।",
   "f0": 0,
   "f1": 250
  },
  {
   "id": 2,
   "section": "title",
   "start": 8.35,
   "dur": 3.2,
   "vo_at": null,
   "vo_dur": null,
   "text": "दशैँ",
   "f0": 250,
   "f1": 346
  },
  {
   "id": 3,
   "section": "myth",
   "start": 11.55,
   "dur": 8.95,
   "vo_at": 12.85,
   "vo_dur": 7.05,
   "text": "यो कथा देवी माहात्म्यमा छ — मार्कण्डेय पुराणभित्रको, करिब पन्ध्र सय वर्ष पुरानो संस्कृत ग्रन्थ।",
   "f0": 346,
   "f1": 615
  },
  {
   "id": 4,
   "section": "myth",
   "start": 20.5,
   "dur": 6.45,
   "vo_at": 20.9,
   "vo_dur": 5.45,
   "text": "महिषासुरले वरदान पाएको थियो — कुनै देवता वा पुरुषले उसलाई मार्न सक्ने छैनन्।",
   "f0": 615,
   "f1": 808
  },
  {
   "id": 5,
   "section": "myth",
   "start": 26.95,
   "dur": 7.81,
   "vo_at": 27.35,
   "vo_dur": 6.81,
   "text": "त्यसैले सबै देवताको तेज एकै ठाउँ मिल्यो, र जन्मिइन् — शक्ति, दुर्गा।",
   "f0": 808,
   "f1": 1043
  },
  {
   "id": 6,
   "section": "myth",
   "start": 34.76,
   "dur": 9.01,
   "vo_at": 35.16,
   "vo_dur": 8.01,
   "text": "परम्पराअनुसार नौ रात युद्ध चल्यो। दशौँ दिन असत्यमाथि सत्यको जित भयो — विजया दशमी।",
   "f0": 1043,
   "f1": 1313
  },
  {
   "id": 7,
   "section": "myth",
   "start": 43.77,
   "dur": 5.01,
   "vo_at": 44.17,
   "vo_dur": 4.01,
   "text": "रामले रावणमाथि पाएको विजय पनि यही दिनसँग जोडिन्छ।",
   "f0": 1313,
   "f1": 1463
  },
  {
   "id": 8,
   "section": "Nepal",
   "start": 48.78,
   "dur": 5.35,
   "vo_at": 50.08,
   "vo_dur": 3.45,
   "text": "नेपालमा यो चाडको इतिहास दरबारसँग गाँसिएको छ।",
   "f0": 1463,
   "f1": 1624
  },
  {
   "id": 9,
   "section": "Nepal",
   "start": 54.13,
   "dur": 9.65,
   "vo_at": 54.53,
   "vo_dur": 8.65,
   "text": "मल्ल राजाहरूकी कुलदेवी तलेजु भवानी — जसको मन्दिर वर्षमा एक पटक, नवमीमा, आम मानिसका लागि खुल्छ।",
   "f0": 1624,
   "f1": 1913
  },
  {
   "id": 10,
   "section": "Nepal",
   "start": 63.78,
   "dur": 11.25,
   "vo_at": 64.18,
   "vo_dur": 10.25,
   "text": "वि.सं. १८२५ मा उपत्यका जितेपछि पृथ्वीनारायण शाहले गोरखाबाट फूलपाती हनुमानढोका ल्याउने चलन बसालेको मानिन्छ।",
   "f0": 1913,
   "f1": 2251
  },
  {
   "id": 11,
   "section": "days",
   "start": 75.03,
   "dur": 4.15,
   "vo_at": 76.33,
   "vo_dur": 2.25,
   "text": "पहिलो दिन, घटस्थापना।",
   "f0": 2251,
   "f1": 2375
  },
  {
   "id": 12,
   "section": "days",
   "start": 79.18,
   "dur": 7.57,
   "vo_at": 79.58,
   "vo_dur": 6.57,
   "text": "अँध्यारो कोठामा छरिएको जौ घाम नदेखी पहेँलो जमरा बनेर उम्रन्छ।",
   "f0": 2375,
   "f1": 2602
  },
  {
   "id": 13,
   "section": "days",
   "start": 86.75,
   "dur": 10.295,
   "vo_at": 87.15,
   "vo_dur": 9.295,
   "text": "सातौँ दिन फूलपाती — केरा, बेल, बेसार, अनार, धानसहित नौ थरी बिरुवा, र टुँडिखेलमा सलामी।",
   "f0": 2602,
   "f1": 2911
  },
  {
   "id": 14,
   "section": "days",
   "start": 97.045,
   "dur": 8.29,
   "vo_at": 97.445,
   "vo_dur": 7.29,
   "text": "अष्टमीमा कालरात्रिको पूजा; नवमीमा हतियार, औजार र सवारीसाधनको।",
   "f0": 2911,
   "f1": 3160
  },
  {
   "id": 15,
   "section": "days",
   "start": 105.335,
   "dur": 7.41,
   "vo_at": 105.735,
   "vo_dur": 6.41,
   "text": "दशमीमा साइत हेरेर ठूलाबडाको हातबाट रातो टीका र जमरा।",
   "f0": 3160,
   "f1": 3382
  },
  {
   "id": 16,
   "section": "days",
   "start": 112.745,
   "dur": 8.131,
   "vo_at": 113.145,
   "vo_dur": 7.131,
   "text": "अनि पूर्णिमासम्म — कोजाग्रत, 'को जाग्दैछ?' भन्दै लक्ष्मी आउने विश्वास।",
   "f0": 3382,
   "f1": 3626
  },
  {
   "id": 17,
   "section": "people",
   "start": 120.876,
   "dur": 8.07,
   "vo_at": 122.176,
   "vo_dur": 6.17,
   "text": "दशैँ आकाशमा पनि देखिन्छ — गाउँगाउँमा लिङ्गे पिङ, छतछतमा चङ्गा।",
   "f0": 3626,
   "f1": 3868
  },
  {
   "id": 18,
   "section": "people",
   "start": 128.946,
   "dur": 4.05,
   "vo_at": 129.346,
   "vo_dur": 3.05,
   "text": "अनि बाटोभरि घर फर्किनेहरूको लाम।",
   "f0": 3868,
   "f1": 3990
  },
  {
   "id": 19,
   "section": "people",
   "start": 132.996,
   "dur": 8.93,
   "vo_at": 133.396,
   "vo_dur": 7.93,
   "text": "सबै समुदायले यसलाई एउटै तरिकाले मनाउँदैनन्; तर भेटघाट, आशीर्वाद र मिलन धेरैको साझा हो।",
   "f0": 3990,
   "f1": 4258
  },
  {
   "id": 20,
   "section": "blessing",
   "start": 141.926,
   "dur": 7.35,
   "vo_at": 143.226,
   "vo_dur": 5.45,
   "text": "आयु द्रोणसुते, श्रियो दशरथे, शत्रुक्षयं राघवे…",
   "f0": 4258,
   "f1": 4478
  },
  {
   "id": 21,
   "section": "wish",
   "start": 149.276,
   "dur": 6.47,
   "vo_at": 150.576,
   "vo_dur": 4.57,
   "text": "विजया दशमी २०८३ को हार्दिक मंगलमय शुभकामना।",
   "f0": 4478,
   "f1": 4672
  },
  {
   "id": 22,
   "section": "sign",
