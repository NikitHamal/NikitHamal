 "shots": [
  {
   "id": 1,
   "section": "open",
   "start": 0.0,
   "dur": 7.284,
   "vo_at": 1.5,
   "vo_dur": 5.184,
   "text": "हरेक वर्ष असोजको उज्यालो पक्षमा नेपालभरि एउटै कथा फेरि सुनाइन्छ।",
   "f0": 0,
   "f1": 219
  },
  {
   "id": 2,
   "section": "title",
   "start": 7.284,
   "dur": 3.2,
   "vo_at": null,
   "vo_dur": null,
   "text": "दशैँ",
   "f0": 219,
   "f1": 315
  },
  {
   "id": 3,
   "section": "myth",
   "start": 10.484,
   "dur": 9.004,
   "vo_at": 11.784,
   "vo_dur": 7.104,
   "text": "यो कथा देवी माहात्म्यमा छ — मार्कण्डेय पुराणभित्रको, करिब पन्ध्र सय वर्ष पुरानो संस्कृत ग्रन्थ।",
   "f0": 315,
   "f1": 585
  },
  {
   "id": 4,
   "section": "myth",
   "start": 19.488,
   "dur": 6.88,
   "vo_at": 19.888,
   "vo_dur": 5.88,
   "text": "महिषासुरले वरदान पाएको थियो — कुनै देवता वा पुरुषले उसलाई मार्न सक्ने छैनन्।",
   "f0": 585,
   "f1": 791
  },
  {
   "id": 5,
   "section": "myth",
   "start": 26.368,
   "dur": 6.208,
   "vo_at": 26.768,
   "vo_dur": 5.208,
   "text": "त्यसैले सबै देवताको तेज एकै ठाउँ मिल्यो, र जन्मिइन् — शक्ति, दुर्गा।",
   "f0": 791,
   "f1": 977
  },
  {
   "id": 6,
   "section": "myth",
   "start": 32.576,
   "dur": 8.296,
   "vo_at": 32.976,
   "vo_dur": 7.296,
   "text": "परम्पराअनुसार नौ रात युद्ध चल्यो। दशौँ दिन असत्यमाथि सत्यको जित भयो — विजया दशमी।",
   "f0": 977,
   "f1": 1226
  },
  {
   "id": 7,
   "section": "myth",
   "start": 40.872,
   "dur": 5.344,
   "vo_at": 41.272,
   "vo_dur": 4.344,
   "text": "रामले रावणमाथि पाएको विजय पनि यही दिनसँग जोडिन्छ।",
   "f0": 1226,
   "f1": 1386
  },
  {
   "id": 8,
   "section": "Nepal",
   "start": 46.216,
   "dur": 5.956,
   "vo_at": 47.516,
   "vo_dur": 4.056,
   "text": "नेपालमा यो चाडको इतिहास दरबारसँग गाँसिएको छ।",
   "f0": 1386,
   "f1": 1565
  },
  {
   "id": 9,
   "section": "Nepal",
   "start": 52.172,
   "dur": 8.656,
   "vo_at": 52.572,
   "vo_dur": 7.656,
   "text": "मल्ल राजाहरूकी कुलदेवी तलेजु भवानी — जसको मन्दिर वर्षमा एक पटक, नवमीमा, आम मानिसका लागि खुल्छ।",
   "f0": 1565,
   "f1": 1825
  },
  {
   "id": 10,
   "section": "Nepal",
   "start": 60.828,
   "dur": 10.36,
   "vo_at": 61.228,
   "vo_dur": 9.36,
   "text": "वि.सं. १८२५ मा उपत्यका जितेपछि पृथ्वीनारायण शाहले गोरखाबाट फूलपाती हनुमानढोका ल्याउने चलन बसालेको मानिन्छ।",
   "f0": 1825,
   "f1": 2136
  },
  {
   "id": 11,
   "section": "days",
   "start": 71.188,
   "dur": 4.348,
   "vo_at": 72.488,
   "vo_dur": 2.448,
   "text": "पहिलो दिन, घटस्थापना।",
   "f0": 2136,
   "f1": 2266
  },
  {
   "id": 12,
   "section": "days",
   "start": 75.536,
   "dur": 6.016,
   "vo_at": 75.936,
   "vo_dur": 5.016,
   "text": "अँध्यारो कोठामा छरिएको जौ घाम नदेखी पहेँलो जमरा बनेर उम्रन्छ।",
   "f0": 2266,
   "f1": 2447
  },
  {
   "id": 13,
   "section": "days",
   "start": 81.552,
   "dur": 7.768,
   "vo_at": 81.952,
   "vo_dur": 6.768,
   "text": "सातौँ दिन फूलपाती — केरा, बेल, बेसार, अनार, धानसहित नौ थरी बिरुवा, र टुँडिखेलमा सलामी।",
   "f0": 2447,
   "f1": 2680
  },
  {
   "id": 14,
   "section": "days",
   "start": 89.32,
   "dur": 6.28,
   "vo_at": 89.72,
   "vo_dur": 5.28,
   "text": "अष्टमीमा कालरात्रिको पूजा; नवमीमा हतियार, औजार र सवारीसाधनको।",
   "f0": 2680,
   "f1": 2868
  },
  {
   "id": 15,
   "section": "days",
   "start": 95.6,
   "dur": 5.68,
   "vo_at": 96.0,
   "vo_dur": 4.68,
   "text": "दशमीमा साइत हेरेर ठूलाबडाको हातबाट रातो टीका र जमरा।",
   "f0": 2868,
   "f1": 3038
  },
  {
   "id": 16,
   "section": "days",
   "start": 101.28,
   "dur": 6.064,
   "vo_at": 101.68,
   "vo_dur": 5.064,
   "text": "अनि पूर्णिमासम्म — कोजाग्रत, 'को जाग्दैछ?' भन्दै लक्ष्मी आउने विश्वास।",
   "f0": 3038,
   "f1": 3220
  },
  {
   "id": 17,
   "section": "people",
   "start": 107.344,
   "dur": 7.06,
   "vo_at": 108.644,
   "vo_dur": 5.16,
   "text": "दशैँ आकाशमा पनि देखिन्छ — गाउँगाउँमा लिङ्गे पिङ, छतछतमा चङ्गा।",
   "f0": 3220,
   "f1": 3432
  },
  {
   "id": 18,
   "section": "people",
   "start": 114.404,
   "dur": 4.144,
   "vo_at": 114.804,
   "vo_dur": 3.144,
   "text": "अनि बाटोभरि घर फर्किनेहरूको लाम।",
   "f0": 3432,
   "f1": 3556
  },
  {
   "id": 19,
   "section": "people",
   "start": 118.548,
   "dur": 7.816,
   "vo_at": 118.948,
   "vo_dur": 6.816,
   "text": "सबै समुदायले यसलाई एउटै तरिकाले मनाउँदैनन्; तर भेटघाट, आशीर्वाद र मिलन धेरैको साझा हो।",
   "f0": 3556,
   "f1": 3791
  },
  {
   "id": 20,
   "section": "blessing",
   "start": 126.364,
   "dur": 6.412,
   "vo_at": 127.664,
   "vo_dur": 4.512,
   "text": "आयु द्रोणसुते, श्रियो दशरथे, शत्रुक्षयं राघवे…",
   "f0": 3791,
   "f1": 3983
  },
  {
   "id": 21,
   "section": "wish",
   "start": 132.776,
   "dur": 6.604,
   "vo_at": 134.076,
   "vo_dur": 4.704,
   "text": "विजया दशमी २०८३ को हार्दिक मंगलमय शुभकामना।",
   "f0": 3983,
   "f1": 4181
  },
  {
