 "shots": [
  {
   "id": 1,
   "section": "open",
   "start": 0.0,
   "dur": 7.51,
   "vo_at": 1.5,
   "vo_dur": 5.41,
   "text": "एउटा दियो बल्छ — र सयौँ वर्ष पुरानो कथा फेरि ब्युँझिन्छ।",
   "f0": 0,
   "f1": 225
  },
  {
   "id": 2,
   "section": "title",
   "start": 7.51,
   "dur": 3.2,
   "vo_at": null,
   "vo_dur": null,
   "text": "दशैँ",
   "f0": 225,
   "f1": 321
  },
  {
   "id": 3,
   "section": "myth",
   "start": 10.71,
   "dur": 8.8,
   "vo_at": 12.01,
   "vo_dur": 6.9,
   "text": "यो कथा देवी माहात्म्यमा छ — मार्कण्डेय पुराणभित्रको, करिब पन्ध्र सय वर्ष पुरानो संस्कृत ग्रन्थ।",
   "f0": 321,
   "f1": 585
  },
  {
   "id": 4,
   "section": "myth",
   "start": 19.51,
   "dur": 6.61,
   "vo_at": 19.91,
   "vo_dur": 5.61,
   "text": "महिषासुरले वरदान पाएको थियो — कुनै देवता वा पुरुषले उसलाई मार्न सक्ने छैनन्।",
   "f0": 585,
   "f1": 784
  },
  {
   "id": 5,
   "section": "myth",
   "start": 26.12,
   "dur": 6.71,
   "vo_at": 26.52,
   "vo_dur": 5.71,
   "text": "त्यसैले सबै देवताको तेज एकै ठाउँ मिल्यो, र जन्मिइन् — शक्ति, दुर्गा।",
   "f0": 784,
   "f1": 985
  },
  {
   "id": 6,
   "section": "myth",
   "start": 32.83,
   "dur": 7.98,
   "vo_at": 33.23,
   "vo_dur": 6.98,
   "text": "परम्पराअनुसार नौ रात युद्ध चल्यो। दशौँ दिन असत्यमाथि सत्यको जित भयो — विजया दशमी।",
   "f0": 985,
   "f1": 1224
  },
  {
   "id": 7,
   "section": "myth",
   "start": 40.81,
   "dur": 4.97,
   "vo_at": 41.21,
   "vo_dur": 3.97,
   "text": "रामले रावणमाथि पाएको विजय पनि यही दिनसँग जोडिन्छ।",
   "f0": 1224,
   "f1": 1373
  },
  {
   "id": 8,
   "section": "Nepal",
   "start": 45.78,
   "dur": 5.7,
   "vo_at": 47.08,
   "vo_dur": 3.8,
   "text": "नेपालमा यो चाडको इतिहास दरबारसँग गाँसिएको छ।",
   "f0": 1373,
   "f1": 1544
  },
  {
   "id": 9,
   "section": "Nepal",
   "start": 51.48,
   "dur": 8.62,
   "vo_at": 51.88,
   "vo_dur": 7.62,
   "text": "मल्ल राजाहरूकी कुलदेवी तलेजु भवानी — जसको मन्दिर वर्षमा एक पटक, नवमीमा, आम मानिसका लागि खुल्छ।",
   "f0": 1544,
   "f1": 1803
  },
  {
   "id": 10,
   "section": "Nepal",
   "start": 60.1,
   "dur": 9.51,
   "vo_at": 60.5,
   "vo_dur": 8.51,
   "text": "वि.सं. १८२५ मा उपत्यका जितेपछि पृथ्वीनारायण शाहले गोरखाबाट फूलपाती हनुमानढोका ल्याउने चलन बसालेको मानिन्छ।",
   "f0": 1803,
   "f1": 2088
  },
  {
   "id": 11,
   "section": "days",
   "start": 69.61,
   "dur": 3.84,
   "vo_at": 70.91,
   "vo_dur": 1.94,
   "text": "पहिलो दिन, घटस्थापना।",
   "f0": 2088,
   "f1": 2204
  },
  {
   "id": 12,
   "section": "days",
   "start": 73.45,
   "dur": 6.51,
   "vo_at": 73.85,
   "vo_dur": 5.51,
   "text": "अँध्यारो कोठामा छरिएको जौ घाम नदेखी पहेँलो जमरा बनेर उम्रन्छ।",
   "f0": 2204,
   "f1": 2399
  },
  {
   "id": 13,
   "section": "days",
   "start": 79.96,
   "dur": 8.66,
   "vo_at": 80.36,
   "vo_dur": 7.66,
   "text": "सातौँ दिन फूलपाती — केरा, बेल, बेसार, अनार, धानसहित नौ थरी बिरुवा, र टुँडिखेलमा सलामी।",
   "f0": 2399,
   "f1": 2659
  },
  {
   "id": 14,
   "section": "days",
   "start": 88.62,
   "dur": 6.62,
   "vo_at": 89.02,
   "vo_dur": 5.62,
   "text": "अष्टमीमा कालरात्रिको पूजा; नवमीमा हतियार, औजार र सवारीसाधनको।",
   "f0": 2659,
   "f1": 2857
  },
  {
   "id": 15,
   "section": "days",
   "start": 95.24,
   "dur": 5.75,
   "vo_at": 95.64,
   "vo_dur": 4.75,
   "text": "दशमीमा साइत हेरेर ठूलाबडाको हातबाट रातो टीका र जमरा।",
   "f0": 2857,
   "f1": 3030
  },
  {
   "id": 16,
   "section": "days",
   "start": 100.99,
   "dur": 6.77,
   "vo_at": 101.39,
   "vo_dur": 5.77,
   "text": "अनि पूर्णिमासम्म — कोजाग्रत, 'को जाग्दैछ?' भन्दै लक्ष्मी आउने विश्वास।",
   "f0": 3030,
   "f1": 3233
  },
  {
   "id": 17,
   "section": "people",
   "start": 107.76,
   "dur": 6.63,
   "vo_at": 109.06,
   "vo_dur": 4.73,
   "text": "दशैँ आकाशमा पनि देखिन्छ — गाउँगाउँमा लिङ्गे पिङ, छतछतमा चङ्गा।",
   "f0": 3233,
   "f1": 3432
  },
  {
   "id": 18,
   "section": "people",
   "start": 114.39,
   "dur": 4.2,
   "vo_at": 114.79,
   "vo_dur": 3.2,
   "text": "अनि बाटोभरि घर फर्किनेहरूको लाम।",
   "f0": 3432,
   "f1": 3558
  },
  {
   "id": 19,
   "section": "people",
   "start": 118.59,
   "dur": 7.78,
   "vo_at": 118.99,
   "vo_dur": 6.78,
   "text": "सबै समुदायले यसलाई एउटै तरिकाले मनाउँदैनन्; तर भेटघाट, आशीर्वाद र मिलन धेरैको साझा हो।",
   "f0": 3558,
   "f1": 3791
  },
  {
   "id": 20,
   "section": "blessing",
   "start": 126.37,
   "dur": 6.83,
   "vo_at": 127.67,
   "vo_dur": 4.93,
   "text": "आयु द्रोणसुते, श्रियो दशरथे, शत्रुक्षयं राघवे…",
   "f0": 3791,
   "f1": 3996
  },
  {
   "id": 21,
   "section": "wish",
   "start": 133.2,
   "dur": 6.136,
   "vo_at": 134.5,
   "vo_dur": 4.236,
   "text": "विजया दशमी २०८३ को हार्दिक मंगलमय शुभकामना।",
   "f0": 3996,
   "f1": 4180
  },
