 "frames": 4279,
 "shots": [
  {
   "id": 1,
   "section": "open",
   "start": 0.0,
   "dur": 6.54,
   "vo_at": 1.5,
   "vo_dur": 4.44,
   "text": "एउटा दियो बल्छ — र सयौँ वर्ष पुरानो कथा फेरि ब्युँझिन्छ।",
   "f0": 0,
   "f1": 196
  },
  {
   "id": 2,
   "section": "title",
   "start": 6.54,
   "dur": 3.2,
   "vo_at": null,
   "vo_dur": null,
   "text": "दशैँ",
   "f0": 196,
   "f1": 292
  },
  {
   "id": 3,
   "section": "myth",
   "start": 9.74,
   "dur": 9.004,
   "vo_at": 11.04,
   "vo_dur": 7.104,
   "text": "यो कथा देवी माहात्म्यमा छ — मार्कण्डेय पुराणभित्रको, करिब पन्ध्र सय वर्ष पुरानो संस्कृत ग्रन्थ।",
   "f0": 292,
   "f1": 562
  },
  {
   "id": 4,
   "section": "myth",
   "start": 18.744,
   "dur": 6.88,
   "vo_at": 19.144,
   "vo_dur": 5.88,
   "text": "महिषासुरले वरदान पाएको थियो — कुनै देवता वा पुरुषले उसलाई मार्न सक्ने छैनन्।",
   "f0": 562,
   "f1": 769
  },
  {
   "id": 5,
   "section": "myth",
   "start": 25.624,
   "dur": 6.208,
   "vo_at": 26.024,
   "vo_dur": 5.208,
   "text": "त्यसैले सबै देवताको तेज एकै ठाउँ मिल्यो, र जन्मिइन् — शक्ति, दुर्गा।",
   "f0": 769,
   "f1": 955
  },
  {
   "id": 6,
   "section": "myth",
   "start": 31.832,
   "dur": 8.296,
   "vo_at": 32.232,
   "vo_dur": 7.296,
   "text": "परम्पराअनुसार नौ रात युद्ध चल्यो। दशौँ दिन असत्यमाथि सत्यको जित भयो — विजया दशमी।",
   "f0": 955,
   "f1": 1204
  },
  {
   "id": 7,
   "section": "myth",
   "start": 40.128,
   "dur": 5.344,
   "vo_at": 40.528,
   "vo_dur": 4.344,
   "text": "रामले रावणमाथि पाएको विजय पनि यही दिनसँग जोडिन्छ।",
   "f0": 1204,
   "f1": 1364
  },
  {
   "id": 8,
   "section": "Nepal",
   "start": 45.472,
   "dur": 5.956,
   "vo_at": 46.772,
   "vo_dur": 4.056,
   "text": "नेपालमा यो चाडको इतिहास दरबारसँग गाँसिएको छ।",
   "f0": 1364,
   "f1": 1543
  },
  {
   "id": 9,
   "section": "Nepal",
   "start": 51.428,
   "dur": 8.656,
   "vo_at": 51.828,
   "vo_dur": 7.656,
   "text": "मल्ल राजाहरूकी कुलदेवी तलेजु भवानी — जसको मन्दिर वर्षमा एक पटक, नवमीमा, आम मानिसका लागि खुल्छ।",
   "f0": 1543,
   "f1": 1803
  },
  {
   "id": 10,
   "section": "Nepal",
   "start": 60.084,
   "dur": 10.36,
   "vo_at": 60.484,
   "vo_dur": 9.36,
   "text": "वि.सं. १८२५ मा उपत्यका जितेपछि पृथ्वीनारायण शाहले गोरखाबाट फूलपाती हनुमानढोका ल्याउने चलन बसालेको मानिन्छ।",
   "f0": 1803,
   "f1": 2113
  },
  {
   "id": 11,
   "section": "days",
   "start": 70.444,
   "dur": 4.348,
   "vo_at": 71.744,
   "vo_dur": 2.448,
   "text": "पहिलो दिन, घटस्थापना।",
   "f0": 2113,
   "f1": 2244
  },
  {
   "id": 12,
   "section": "days",
   "start": 74.792,
   "dur": 6.016,
   "vo_at": 75.192,
   "vo_dur": 5.016,
   "text": "अँध्यारो कोठामा छरिएको जौ घाम नदेखी पहेँलो जमरा बनेर उम्रन्छ।",
   "f0": 2244,
   "f1": 2424
  },
  {
   "id": 13,
   "section": "days",
   "start": 80.808,
   "dur": 7.768,
   "vo_at": 81.208,
   "vo_dur": 6.768,
   "text": "सातौँ दिन फूलपाती — केरा, बेल, बेसार, अनार, धानसहित नौ थरी बिरुवा, र टुँडिखेलमा सलामी।",
   "f0": 2424,
   "f1": 2657
  },
  {
   "id": 14,
   "section": "days",
   "start": 88.576,
   "dur": 6.28,
   "vo_at": 88.976,
   "vo_dur": 5.28,
   "text": "अष्टमीमा कालरात्रिको पूजा; नवमीमा हतियार, औजार र सवारीसाधनको।",
   "f0": 2657,
   "f1": 2846
  },
  {
   "id": 15,
   "section": "days",
   "start": 94.856,
   "dur": 5.68,
   "vo_at": 95.256,
   "vo_dur": 4.68,
   "text": "दशमीमा साइत हेरेर ठूलाबडाको हातबाट रातो टीका र जमरा।",
   "f0": 2846,
   "f1": 3016
  },
  {
   "id": 16,
   "section": "days",
   "start": 100.536,
   "dur": 6.064,
   "vo_at": 100.936,
   "vo_dur": 5.064,
   "text": "अनि पूर्णिमासम्म — कोजाग्रत, 'को जाग्दैछ?' भन्दै लक्ष्मी आउने विश्वास।",
   "f0": 3016,
   "f1": 3198
  },
  {
   "id": 17,
   "section": "people",
   "start": 106.6,
   "dur": 7.06,
   "vo_at": 107.9,
   "vo_dur": 5.16,
   "text": "दशैँ आकाशमा पनि देखिन्छ — गाउँगाउँमा लिङ्गे पिङ, छतछतमा चङ्गा।",
   "f0": 3198,
   "f1": 3410
  },
  {
   "id": 18,
   "section": "people",
   "start": 113.66,
   "dur": 4.144,
   "vo_at": 114.06,
   "vo_dur": 3.144,
   "text": "अनि बाटोभरि घर फर्किनेहरूको लाम।",
   "f0": 3410,
   "f1": 3534
  },
  {
   "id": 19,
   "section": "people",
   "start": 117.804,
   "dur": 7.816,
   "vo_at": 118.204,
   "vo_dur": 6.816,
   "text": "सबै समुदायले यसलाई एउटै तरिकाले मनाउँदैनन्; तर भेटघाट, आशीर्वाद र मिलन धेरैको साझा हो।",
   "f0": 3534,
   "f1": 3769
  },
  {
   "id": 20,
   "section": "blessing",
   "start": 125.62,
   "dur": 6.412,
   "vo_at": 126.92,
   "vo_dur": 4.512,
   "text": "आयु द्रोणसुते, श्रियो दशरथे, शत्रुक्षयं राघवे…",
   "f0": 3769,
   "f1": 3961
  },
  {
   "id": 21,
   "section": "wish",
   "start": 132.032,
   "dur": 6.604,
   "vo_at": 133.332,
   "vo_dur": 4.704,
   "text": "विजया दशमी २०८३ को हार्दिक मंगलमय शुभकामना।",
   "f0": 3961,
   "f1": 4159
  },
