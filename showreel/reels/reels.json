{
  "_doc": "One entry per reel. 100 BPM: beat = 36 frames. Each beat block runs [from, to) in frames; lines land word by word from `at` (frames after `from`) every `step` frames. `kind` picks a special animation in film.js; `mode` is light (paper) or dark (ink). score.py reads this same file, so picture and sound stay in sync.",
  "the-lie-of-being-yourself": { "title": "The lie of “being yourself”", "cat": "An essay", "date": "September 22, 2026", "key": 50, "ghost": "SELF", "beats": [
    { "from": 0, "to": 216, "mode": "dark", "kind": "impact", "lines": [ { "t": "Which self", "at": 4, "step": 18, "size": 150, "f": "serif", "c": "paper", "y": -0.55 }, { "t": "are you talking about?", "at": 54, "step": 9, "size": 96, "f": "serifI", "c": "pink", "y": 0.6 } ] },
    { "from": 216, "to": 432, "mode": "light", "kind": "impact", "lines": [ { "t": "The one who was laughing", "at": 6, "step": 9, "size": 76, "f": "serif", "c": "ink", "y": -1.6 }, { "t": "with someone yesterday,", "at": 36, "step": 9, "size": 76, "f": "serif", "c": "ink", "y": -0.6 }, { "t": "or the one who doesn't want", "at": 90, "step": 9, "size": 76, "f": "serifI", "c": "pink", "y": 0.6 }, { "t": "to speak to anyone today?", "at": 126, "step": 9, "size": 76, "f": "serifI", "c": "pink", "y": 1.6 } ] },
    { "from": 432, "to": 648, "mode": "light", "kind": "strike", "lines": [ { "t": "Be yourself.", "at": 4, "step": 4, "size": 110, "f": "serif", "c": "ink", "y": -1.25 }, { "t": "Find yourself.", "at": 40, "step": 4, "size": 110, "f": "serif", "c": "ink", "y": 0 }, { "t": "Know who you really are.", "at": 76, "step": 4, "size": 92, "f": "serif", "c": "ink", "y": 1.25 } ], "strikes": [130, 148, 166] },
    { "from": 648, "to": 864, "mode": "dark", "kind": "dis", "lines": [ { "t": "Their approval used to guide you.", "at": 6, "step": 9, "size": 84, "f": "serif", "c": "paper", "y": -0.7 }, { "t": "Now their approval guides you.", "at": 72, "step": 9, "size": 84, "f": "serifI", "c": "pink", "y": 0.7 } ], "dis": 126 },
    { "from": 864, "to": 1080, "mode": "light", "kind": "impact", "lines": [ { "t": "We select the qualities", "at": 6, "step": 9, "size": 84, "f": "serif", "c": "ink", "y": -1.1 }, { "t": "we are comfortable owning", "at": 42, "step": 9, "size": 84, "f": "serif", "c": "ink", "y": 0 }, { "t": "and call them our nature.", "at": 96, "step": 12, "size": 92, "f": "serifI", "c": "pink", "y": 1.2 } ] },
    { "from": 1080, "to": 1224, "mode": "light", "kind": "center", "lines": [ { "t": "There is no center to uncover.", "at": 30, "step": 9, "size": 92, "f": "serif", "c": "ink", "y": 0.9 } ] },
    { "from": 1224, "to": 1404, "mode": "dark", "kind": "impact", "lines": [ { "t": "You don't need to choose", "at": 4, "step": 9, "size": 100, "f": "serif", "c": "paper", "y": -0.6 }, { "t": "a version to keep.", "at": 54, "step": 12, "size": 100, "f": "serifI", "c": "pink", "y": 0.6 } ] }
  ] },
  "the-wrong-guy-trying-to-wake-up": { "title": "The Wrong Guy Trying to Wake Up", "cat": "An essay", "date": "February 14, 2026", "key": 52, "ghost": "DREAM", "beats": [
    { "from": 0, "to": 216, "mode": "dark", "kind": "again", "lines": [ { "t": "The sleeper is not the dreamer.", "at": 4, "step": 12, "size": 104, "f": "serif", "c": "paper", "y": -0.3 }, { "t": "Read that again.", "at": 90, "step": 12, "size": 60, "f": "serifI", "c": "pink", "y": 1.2 } ], "again": 132 },
    { "from": 216, "to": 576, "mode": "light", "kind": "dog", "lines": [ { "t": "The faster the dog runs,", "at": 20, "step": 9, "size": 72, "f": "serif", "c": "ink", "y": -3.4 }, { "t": "the faster the tail escapes.", "at": 56, "step": 9, "size": 72, "f": "serifI", "c": "pink", "y": -2.4 }, { "t": "The dog cannot catch its tail", "at": 220, "step": 9, "size": 66, "f": "serif", "c": "ink", "y": 2.6 }, { "t": "by running faster.", "at": 256, "step": 9, "size": 66, "f": "serifI", "c": "ink2", "y": 3.6 } ], "stop": 210 },
    { "from": 576, "to": 792, "mode": "dark", "kind": "impact", "lines": [ { "t": "The dreamer cannot wake up", "at": 4, "step": 9, "size": 96, "f": "serif", "c": "paper", "y": -0.6 }, { "t": "by trying harder.", "at": 54, "step": 12, "size": 96, "f": "serifI", "c": "pink", "y": 0.6 } ] },
    { "from": 792, "to": 1044, "mode": "light", "kind": "impact", "lines": [ { "t": "What you are looking for", "at": 6, "step": 9, "size": 84, "f": "serif", "c": "ink", "y": -1.3 }, { "t": "is your own death.", "at": 42, "step": 12, "size": 110, "f": "serifI", "c": "pink", "y": 0 }, { "t": "Not physical death.", "at": 120, "step": 9, "size": 54, "f": "serif", "c": "ink2", "y": 1.5 }, { "t": "The death of the one looking.", "at": 150, "step": 9, "size": 54, "f": "serif", "c": "ink2", "y": 2.3 } ] },
    { "from": 1044, "to": 1404, "mode": "light", "kind": "wake", "lines": [ { "t": "And yet.", "at": 6, "step": 12, "size": 96, "f": "serifI", "c": "ink", "y": 0 }, { "t": "Waking happens.", "at": 150, "step": 12, "size": 92, "f": "serif", "c": "ink", "y": 0 }, { "t": "Every single morning, without trying.", "at": 210, "step": 9, "size": 56, "f": "serifI", "c": "pink", "y": 1.2 } ], "open": 144 }
  ] },
  "you-never-trusted-anyone-2": { "title": "You never trusted anyone (2)", "cat": "An essay", "date": "January 23, 2026", "key": 47, "ghost": "TRUST", "beats": [
    { "from": 0, "to": 216, "mode": "dark", "kind": "impact", "lines": [ { "t": "You never trusted anyone.", "at": 4, "step": 12, "size": 112, "f": "serif", "c": "paper", "y": -0.5 }, { "t": "What you felt was security.", "at": 90, "step": 9, "size": 72, "f": "serifI", "c": "pink", "y": 0.8 } ] },
    { "from": 216, "to": 432, "mode": "light", "kind": "brackets", "lines": [ { "t": "You say you want trust,", "at": 6, "step": 9, "size": 84, "f": "serif", "c": "ink", "y": -1.5 }, { "t": "but what you really want is", "at": 48, "step": 9, "size": 66, "f": "serif", "c": "ink2", "y": -0.5 } ], "word": "security.", "lock": 120 },
    { "from": 432, "to": 648, "mode": "light", "kind": "un", "lines": [ { "t": "Trust can only exist", "at": 6, "step": 9, "size": 84, "f": "serif", "c": "ink", "y": -1.6 }, { "t": "where there is", "at": 40, "step": 9, "size": 84, "f": "serif", "c": "ink", "y": -0.6 } ], "word": "certainty.", "un": 120 },
    { "from": 648, "to": 864, "mode": "dark", "kind": "breaks", "lines": [ { "t": "Trust is not something that can be broken;", "at": 4, "step": 7, "size": 70, "f": "serif", "c": "paper", "y": -0.9 }, { "t": "it is security that breaks.", "at": 66, "step": 10, "size": 96, "f": "serifI", "c": "pink", "y": 0.5 } ], "crack": 150 },
    { "from": 864, "to": 1116, "mode": "light", "kind": "wind", "lines": [ { "t": "How can you catch the wind", "at": 6, "step": 9, "size": 92, "f": "serif", "c": "ink", "y": -0.6 }, { "t": "with your palms?", "at": 48, "step": 12, "size": 92, "f": "serifI", "c": "pink", "y": 0.6 } ], "blow": 150 },
    { "from": 1116, "to": 1404, "mode": "dark", "kind": "impact", "lines": [ { "t": "The art of being in the moment,", "at": 4, "step": 9, "size": 76, "f": "serif", "c": "paper", "y": -1.6 }, { "t": "feeling the wind fully", "at": 46, "step": 9, "size": 76, "f": "serif", "c": "paper", "y": -0.6 }, { "t": "without trying to catch it,", "at": 82, "step": 9, "size": 76, "f": "serif", "c": "paper", "y": 0.4 }, { "t": "is love.", "at": 140, "step": 18, "size": 140, "f": "serifI", "c": "pink", "y": 1.75 } ] }
  ] },
  "where-is-god": { "title": "Where is God?", "cat": "A reflection", "date": "February 27, 2025", "key": 50, "ghost": "GOD", "beats": [
    { "from": 0, "to": 216, "mode": "dark", "kind": "impact", "lines": [ { "t": "When you seek god,", "at": 4, "step": 12, "size": 110, "f": "serif", "c": "paper", "y": -0.6 }, { "t": "you kill god.", "at": 72, "step": 18, "size": 130, "f": "serifI", "c": "pink", "y": 0.65 } ] },
    { "from": 216, "to": 576, "mode": "light", "kind": "couplets", "pairs": [ ["God is neither in,", "nor out."], ["God is neither above,", "nor below."], ["God is neither time,", "nor the timeless."] ], "lines": [] },
    { "from": 576, "to": 792, "mode": "dark", "kind": "impact", "lines": [ { "t": "When I am the whole space,", "at": 4, "step": 9, "size": 92, "f": "serif", "c": "paper", "y": -0.6 }, { "t": "what space is left for me to move?", "at": 54, "step": 9, "size": 76, "f": "serifI", "c": "pink", "y": 0.6 } ] },
    { "from": 792, "to": 1044, "mode": "light", "kind": "drops", "lines": [ { "t": "To seek god is like seeking the ocean.", "at": 4, "step": 7, "size": 66, "f": "serif", "c": "ink", "y": -3.3 }, { "t": "All you can find is the countless drops of water.", "at": 150, "step": 6, "size": 56, "f": "serifI", "c": "ink2", "y": 3.4 } ], "word": "ocean", "fall": 70 },
    { "from": 1044, "to": 1404, "mode": "light", "kind": "gather", "lines": [ { "t": "But when you see that the countless drops", "at": 4, "step": 6, "size": 62, "f": "serif", "c": "ink", "y": -3.3 }, { "t": "are simply one drop,", "at": 60, "step": 9, "size": 62, "f": "serif", "c": "ink", "y": -2.4 }, { "t": "it is the ocean.", "at": 220, "step": 14, "size": 120, "f": "serifI", "c": "pink", "y": 2.6 } ], "gather": 96 }
  ] },
  "i-offer-my-curse-to-god": { "title": "I offer my curse to God", "cat": "A reflection", "date": "November 25, 2024", "key": 43, "ghost": "GOD", "beats": [
    { "from": 0, "to": 216, "mode": "dark", "kind": "impact", "lines": [ { "t": "If god is pleased by prayers,", "at": 4, "step": 9, "size": 84, "f": "serif", "c": "paper", "y": -0.7 }, { "t": "I will offer him curses.", "at": 72, "step": 12, "size": 104, "f": "serifI", "c": "pink", "y": 0.6 } ] },
    { "from": 216, "to": 792, "mode": "light", "kind": "swaps", "swaps": [ ["If god is pleased by gold and diamonds,", "gold", "mud"], ["If god is pleased by tears of devotion,", "tears", "laughter"], ["If God desires my humility,", "humility", "defiance"], ["If God seeks worship,", "worship", ""] ], "lines": [] },
    { "from": 792, "to": 1008, "mode": "dark", "kind": "impact", "lines": [ { "t": "For if this God is real,", "at": 4, "step": 9, "size": 92, "f": "serif", "c": "paper", "y": -0.7 }, { "t": "he would not demand, nor expect.", "at": 54, "step": 9, "size": 76, "f": "serifI", "c": "pink", "y": 0.6 } ] },
    { "from": 1008, "to": 1224, "mode": "light", "kind": "impact", "lines": [ { "t": "Instead, I will seek to understand", "at": 4, "step": 9, "size": 76, "f": "serif", "c": "ink", "y": -0.9 }, { "t": "the truth of life,", "at": 60, "step": 9, "size": 88, "f": "serifI", "c": "pink", "y": 0.2 }, { "t": "the truth of myself.", "at": 96, "step": 9, "size": 88, "f": "serifI", "c": "pink", "y": 1.25 } ] },
    { "from": 1224, "to": 1404, "mode": "dark", "kind": "impact", "lines": [ { "t": "perhaps, lies the only offering", "at": 4, "step": 9, "size": 84, "f": "serif", "c": "paper", "y": -0.6 }, { "t": "that matters.", "at": 60, "step": 18, "size": 120, "f": "serifI", "c": "pink", "y": 0.65 } ] }
  ] },
  "you": { "title": "You", "cat": "A poem", "date": "December 3, 2024", "key": 50, "ghost": "YOU", "beats": [
    { "from": 0, "to": 216, "mode": "dark", "kind": "impact", "lines": [ { "t": "a home,", "at": 4, "step": 18, "size": 130, "f": "serif", "c": "paper", "y": -0.55 }, { "t": "for the homeless me,", "at": 54, "step": 12, "size": 96, "f": "serifI", "c": "pink", "y": 0.6 } ] },
    { "from": 216, "to": 504, "mode": "pond", "clip": "golden", "kind": "impact", "lines": [ { "t": "countless drops,", "at": 10, "step": 12, "size": 110, "f": "serif", "c": "paper", "y": -0.55 }, { "t": "for the boundless sea,", "at": 64, "step": 12, "size": 96, "f": "serifI", "c": "blush", "y": 0.6 } ] },
    { "from": 504, "to": 720, "mode": "light", "kind": "impact", "lines": [ { "t": "a sprouting seed,", "at": 4, "step": 12, "size": 110, "f": "serif", "c": "ink", "y": -0.55 }, { "t": "for the huge huge tree,", "at": 54, "step": 12, "size": 96, "f": "serifI", "c": "pink", "y": 0.6 } ] },
    { "from": 720, "to": 936, "mode": "dark", "kind": "impact", "lines": [ { "t": "a sparking spark,", "at": 4, "step": 12, "size": 110, "f": "serif", "c": "paper", "y": -0.55 }, { "t": "for the flame to be,", "at": 54, "step": 12, "size": 96, "f": "serifI", "c": "pink", "y": 0.6 } ] },
    { "from": 936, "to": 1188, "mode": "pond", "clip": "night", "kind": "impact", "lines": [ { "t": "a guiding star,", "at": 10, "step": 12, "size": 110, "f": "serif", "c": "paper", "y": -0.55 }, { "t": "for the lost to see,", "at": 64, "step": 12, "size": 96, "f": "serifI", "c": "blush", "y": 0.6 } ] },
    { "from": 1188, "to": 1404, "mode": "light", "kind": "impact", "lines": [ { "t": "the only truth,", "at": 4, "step": 12, "size": 110, "f": "serif", "c": "ink", "y": -0.55 }, { "t": "for this wandering “me”.", "at": 54, "step": 12, "size": 96, "f": "serifI", "c": "pink", "y": 0.6 } ] }
  ] }
}
